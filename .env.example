# Configuração da aplicação SEDUC Simulados.
# Copie este arquivo para `.env` (que NÃO vai para o git) e ajuste os valores.

# Ambiente: desenvolvimento | producao
SEDU_AMBIENTE=desenvolvimento

# Segredo do JWT. OBRIGATÓRIO em produção (a app recusa subir com placeholder).
# Gere um forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEDU_JWT_SECRET=cole-aqui-um-segredo-forte

# Validade do token em horas.
SEDU_JWT_EXPIRA_HORAS=8

# Banco de dados. SQLite no dev; em produção use PostgreSQL, ex.:
#   postgresql+psycopg://usuario:senha@localhost:5432/seduc_simulados
# SEDU_DATABASE_URL=sqlite:///seduc_questoes.db

# Origens permitidas no CORS (separadas por vírgula). Em produção, restrinja ao domínio real.
SEDU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Habilita a página de demonstração e o seed de demonstração. Deixe false em produção.
SEDU_DEMO_HABILITADO=true

# --- Curadoria de simulado por IA (Claude API) ---
# Desligada por padrão. Com false (ou sem chave), a geração usa a seleção clássica
# do prova_service — nada muda. Ligue só quando tiver a chave da Anthropic.
SEDU_IA_CURADORIA_HABILITADA=false
# Chave da Claude API (https://console.anthropic.com). NÃO comite a chave real.
SEDU_ANTHROPIC_API_KEY=
# Modelo da Claude API. Padrão: o Opus mais atual.
SEDU_CLAUDE_MODELO=claude-opus-4-8
# Timeout (s) e nº de retentativas da chamada à IA antes de cair no fallback.
SEDU_CLAUDE_TIMEOUT_SEGUNDOS=20
SEDU_CLAUDE_MAX_RETRIES=2
# Confiança mínima (0 a 1) da seleção da IA; abaixo disso, usa o fallback clássico.
SEDU_IA_CURADORIA_CONFIANCA_MINIMA=0.5
# Teto de questões candidatas enviadas à IA (controle de custo/tokens).
SEDU_IA_CURADORIA_MAX_CANDIDATAS=200
# Tolerância (fração da quantidade) de desvio por nível antes de rejeitar a seleção
# da IA por não respeitar a distribuição de dificuldade pedida (cai no clássico).
SEDU_IA_CURADORIA_TOLERANCIA_DISTRIBUICAO=0.2
